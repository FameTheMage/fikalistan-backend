SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Valfritt, standard 3001
PORT=
# Valfritt. Standard: 127.0.0.1 i utveckling, alla nätverkskort i produktion
HOST=
# Valfritt. Heltal: antal proxyer framför servern (t.ex. 1). Sätt inget annat värde
TRUST_PROXY=
# Valfritt. Max skrivande anrop per minut och IP-adress (standard 20)
MAX_SKRIV_PER_MINUT=
# Valfritt. Max skrivande anrop per timme och IP-adress (standard 300)
MAX_SKRIV_PER_TIMME=
